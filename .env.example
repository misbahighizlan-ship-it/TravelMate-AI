# Copy to .env and add your private Ollama Cloud key locally. Never commit .env.
OLLAMA_API_KEY=replace_me_locally
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com/v1
# Paste your private MongoDB Atlas connection string locally; never commit or share it.
MONGODB_URI=
MONGODB_DATABASE=travelmate_ai
MONGODB_COLLECTION=trip_runs
# Optional: protects the internal run-history endpoint.
TRAVELMATE_ADMIN_TOKEN=
